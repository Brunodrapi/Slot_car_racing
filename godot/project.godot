; Le prototype Godot de GRIP — Racing the Line : un circuit, une voiture.
; Ouvrir ce dossier dans Godot 4.7 (Projet > Importer > project.godot).

config_version=5

[application]

config/name="GRIP — prototype Godot"
config/description="Stand de frites et la Breithüft Apex R, avec la physique du jeu web portée en GDScript."
run/main_scene="res://scenes/jeu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=2
2d/snap/snap_2d_transforms_to_pixel=false
