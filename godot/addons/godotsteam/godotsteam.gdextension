; GodotSteam 4.24 (codeberg.org/godotsteam, édition GDExtension, licence MIT), qui donne le
; singleton Steam à la version Steam : salons, invitations, réseau de Valve, identité du joueur.
; Seule la bibliothèque de Windows est dans le dépôt (le Steam Deck lance la version Windows par
; Proton) ; `outils/godotsteam.sh` réinstalle le paquet complet. Les autres préréglages d'export l'excluent
; (exclude_filter) : il ne part qu'avec la version Steam.

[configuration]
entry_symbol = "godotsteam_init"
compatibility_minimum = "4.4"

[libraries]
windows.debug.x86_64 = "res://addons/godotsteam/win64/libgodotsteam.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/godotsteam/win64/libgodotsteam.windows.template_release.x86_64.dll"

[dependencies]
windows.x86_64 = { "res://addons/godotsteam/win64/steam_api64.dll": "" }
